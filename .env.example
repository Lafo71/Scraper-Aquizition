# Bright Data Scraping Browser (vide = Chromium local)
BROWSER_WS=wss://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:9222

# Supabase, Session pooler (IPv4). Caractères spéciaux du mot de passe encodés en URL.
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Dossier des fichiers CSV / XLSX / JSON
OUTPUT_DIR=output
